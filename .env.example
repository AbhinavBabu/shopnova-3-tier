# ──────────────────────────────────────────────────────────────────────────────
# ShopNova — Local Docker Compose environment variables
# Copy this file to .env and fill in real values before running docker compose.
#
#   cp .env.example .env
#
# The defaults below work out-of-the-box with the local mongo container.
# Override any value to point at your Atlas cluster instead.
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB URIs ──────────────────────────────────────────────────────────────
# Local (default) — uses the mongo service started by docker compose
AUTH_MONGO_URI=mongodb://mongo:27017/authdb
PRODUCT_MONGO_URI=mongodb://mongo:27017/productdb
ORDER_MONGO_URI=mongodb://mongo:27017/orderdb

# Atlas (uncomment and replace to use your cloud cluster instead)
# AUTH_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/authdb
# PRODUCT_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/productdb
# ORDER_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/orderdb

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=local_dev_jwt_secret_change_me

# ── Email (Notification Service) ─────────────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
