# ──────────────────────────────────────────────────────────────────────────────
# ShopNova — Backend Environment Variables
# Used by: docker-compose.backend.yml (backend EC2, private subnet)
#
# Copy this file and fill in real values:
#   cp .env.backend .env.backend.local
#
# Then start services:
#   docker compose -f docker-compose.backend.yml --env-file .env.backend.local up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Set MONGO_HOST to the private IP or hostname of your MongoDB EC2.
# All three backend services use this to construct their DB URIs:
#   mongodb://<MONGO_HOST>:27017/<dbname>
MONGO_HOST=<your-mongodb-ec2-private-ip>

# Optional: provide a full URI per service to override MONGO_HOST entirely.
# Useful for MongoDB Atlas or a replica set connection string.
# AUTH_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/authdb
# PRODUCT_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/productdb
# ORDER_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/orderdb

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be identical across all services that verify tokens (auth, order).
JWT_SECRET=your_production_jwt_secret_here

# ── Email (Notification Service) ─────────────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Amazon SQS ───────────────────────────────────────────────────────────────
# The order-service publishes events here; notification-service polls it.
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/YOUR_QUEUE_NAME

# AWS region for the SQS client in order-service and notification-service.
# Must match the region where the SQS queue was created.
AWS_REGION=us-east-1

# ── Legacy HTTP notification vars (reference only — not used in active code) ──
# These are injected for documentation purposes. The active notification path
# is SQS-based. These vars remain so the commented-out HTTP fallback in
# orderController.js can be re-enabled without extra config work.
NOTIFICATION_SERVICE_HOST=notification-service
NOTIFICATION_SERVICE_PORT=8004
