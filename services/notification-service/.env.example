PORT=8004
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Amazon SQS ────────────────────────────────────────────────────────────────
# Queue URL polled by this service to consume order-placed notification events.
# Format: https://sqs.us-east-1.amazonaws.com/<account-id>/<queue-name>
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/YOUR_QUEUE_NAME
