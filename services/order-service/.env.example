PORT=8003
ORDER_MONGO_URI=mongodb://localhost:27017/orderdb
JWT_SECRET=supersecretjwtkey_change_in_production
NODE_ENV=development

# ── Amazon SQS ────────────────────────────────────────────────────────────────
# Full URL of the SQS queue that receives order-placed notification events.
# Format: https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/YOUR_QUEUE_NAME
