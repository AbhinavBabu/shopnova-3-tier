# ──────────────────────────────────────────────────────────────────────────────
# ShopNova — Frontend Environment Variables
# Used by: docker-compose.frontend.yml (frontend EC2, public subnet)
#
# Copy this file and fill in real values:
#   cp .env.frontend .env.frontend.local
#
# Then start services:
#   docker compose -f docker-compose.frontend.yml --env-file .env.frontend.local up -d
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend Service Hosts (nginx runtime routing via envsubst) ────────────────
#
# SPLIT-EC2 + INTERNAL ALB SETUP:
#   Set all three *_SERVICE_HOST vars to the internal ALB DNS name.
#   Set all *_SERVICE_PORT vars to 80 (the ALB listener port).
#   The ALB routes to the correct backend service based on path prefix:
#     /api/auth     → auth-service:8001
#     /api/products → product-service:8002
#     /api/orders   → order-service:8003
#
AUTH_SERVICE_HOST=internal-alb.your-region.elb.amazonaws.com
AUTH_SERVICE_PORT=80

PRODUCT_SERVICE_HOST=internal-alb.your-region.elb.amazonaws.com
PRODUCT_SERVICE_PORT=80

ORDER_SERVICE_HOST=internal-alb.your-region.elb.amazonaws.com
ORDER_SERVICE_PORT=80

# ── VITE Build-time Variables ─────────────────────────────────────────────────
# These are baked into the React bundle at docker build time (not runtime).
# Leave empty ("") — the nginx proxy_pass handles all /api/* routing.
# Only set these if you explicitly need the browser to call backends directly
# without going through nginx (non-standard setup).
VITE_AUTH_SERVICE_URL=
VITE_PRODUCT_SERVICE_URL=
VITE_ORDER_SERVICE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# LOCAL SIMULATION (no ALB):
#   If you are running the frontend locally to talk to a backend EC2 directly,
#   replace the ALB DNS with the backend EC2's public/private IP and use the
#   individual service ports:
#
# AUTH_SERVICE_HOST=<backend-ec2-ip>
# AUTH_SERVICE_PORT=8001
# PRODUCT_SERVICE_HOST=<backend-ec2-ip>
# PRODUCT_SERVICE_PORT=8002
# ORDER_SERVICE_HOST=<backend-ec2-ip>
# ORDER_SERVICE_PORT=8003
# ──────────────────────────────────────────────────────────────────────────────
